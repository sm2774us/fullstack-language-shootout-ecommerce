{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "generate",
        "^build"
      ]
    },
    "container-build": {
      "cache": true,
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "generate": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/proto/**/*"
      ]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default"
    ]
  }
}
