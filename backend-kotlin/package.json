{
  "name": "backend-kotlin",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "gradle build -x test --no-daemon",
          "cwd": "backend-kotlin"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "gradle run --no-daemon",
          "cwd": "backend-kotlin"
        }
      },
      "container-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t backend-kotlin:latest -f ./backend-kotlin/Dockerfile ./backend-kotlin"
        }
      },
      "generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "proto:generate"
        ],
        "cache": true,
        "options": {
          "command": "echo 'stubs provided by proto:generate (buf)'",
          "cwd": "backend-kotlin"
        }
      }
    }
  }
}
