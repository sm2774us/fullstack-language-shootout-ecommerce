{
  "name": "backend-ocaml",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "opam exec -- dune build --release",
          "cwd": "backend-ocaml"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "opam exec -- dune exec bin/main.exe",
          "cwd": "backend-ocaml"
        }
      },
      "container-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t backend-ocaml:latest -f ./backend-ocaml/Dockerfile ./backend-ocaml"
        }
      },
      "generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/proto/ecommerce.proto"
        ],
        "options": {
          "command": "opam exec -- dune build modules/generated",
          "cwd": "backend-ocaml"
        }
      }
    }
  }
}
