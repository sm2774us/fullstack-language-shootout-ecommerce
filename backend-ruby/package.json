{
  "name": "backend-ruby",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bundle config set --local without 'development' && bundle install",
          "cwd": "backend-ruby"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rake serve",
          "cwd": "backend-ruby"
        }
      },
      "container-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t backend-ruby:latest -f ./backend-ruby/Dockerfile ./backend-ruby"
        }
      },
      "generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/proto/ecommerce.proto"
        ],
        "options": {
          "command": "bundle config set --local without '' && bundle install && rake codegen",
          "cwd": "backend-ruby"
        }
      }
    }
  }
}
