source "https://rubygems.org"
ruby ">= 3.3.0"

gem "sinatra", "~> 4.1"
gem "puma", "~> 6.4"
gem "json", "~> 2.7"
gem "rake", "~> 13.2"

group :development do
  # Only used by `rake codegen` (see Rakefile) — never required by the
  # running server (apps/web-api/app.rb). Grouped separately so the
  # production Docker image's `bundle install --without development`
  # never has to compile these two large native-extension gems for a
  # task it never runs.
  gem "grpc-tools", "~> 1.68"
  gem "grpc", "~> 1.68"
end
