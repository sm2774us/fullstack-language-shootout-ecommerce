{
  "name": "backend-cpp",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j",
          "cwd": "backend-cpp"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "./build/backend_cpp",
          "cwd": "backend-cpp"
        }
      },
      "container-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t backend-cpp:latest -f ./backend-cpp/Dockerfile ./backend-cpp"
        }
      },
      "generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "proto:generate"
        ],
        "cache": true,
        "options": {
          "command": "echo 'stubs provided by proto:generate (buf)'",
          "cwd": "backend-cpp"
        }
      }
    }
  }
}
