{
  "name": "backend-golang",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "go build ./...",
          "cwd": "backend-golang"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "go run ./apps/web-api",
          "cwd": "backend-golang"
        }
      },
      "container-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t backend-golang:latest -f ./backend-golang/Dockerfile ./backend-golang"
        }
      },
      "generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "proto:generate"
        ],
        "cache": true,
        "options": {
          "command": "echo 'stubs provided by proto:generate (buf)'",
          "cwd": "backend-golang"
        }
      }
    }
  }
}
